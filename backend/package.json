{
  "name": "@renki/backend",
  "version": "0.1.0",
  "private": true,
  "description": "Renki API server",
  "type": "module",
  "main": "dist/server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "migrate": "tsx src/db/migrate.ts",
    "seed": "tsx src/db/seed.ts",
    "//migrate:prod": "The shipped image has no tsx \u2014 it runs the compiled build.",
    "migrate:prod": "node dist/db/migrate.js",
    "//dev:token": "DEV ONLY. Mints a session token for a seeded account so you can be the second person in a two-person flow. Excluded from the build.",
    "dev:token": "tsx src/scripts/dev-token.ts",
    "//schema:snapshot": "Regenerates schema.sql from the live DB. Run after migrate.",
    "schema:snapshot": "bash scripts/snapshot-schema.sh",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "//test:int": "Integration tests against a REAL Postgres. TRUNCATES every table \u2014 point DATABASE_URL at a scratch database.",
    "test:int": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1118.0",
    "@aws-sdk/s3-request-presigner": "^3.1118.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "google-auth-library": "^11.0.0",
    "h3-js": "^4.5.0",
    "helmet": "^8.1.0",
    "jose": "^6.2.8",
    "morgan": "^1.10.1",
    "multer": "^2.2.0",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.5",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.19.1",
    "@types/pg": "^8.20.3",
    "@types/supertest": "^7.2.1",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.6.2",
    "supertest": "^7.2.2",
    "tsx": "^4.20.7",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4",
    "vitest": "^4.1.10"
  }
}
