{
  "extends": "./tsconfig.json",
  // Narrower than the base include: only src/ is compiled, so vitest.config.ts
  // and *.test.ts never reach dist/ or the production image. src/scripts/ is
  // excluded for the same reason — those are developer commands run with tsx,
  // and shipping a token minter inside the production image is not a risk worth
  // taking for a convenience nobody needs there.
  "compilerOptions": {
    "rootDir": "src"
  },
  "include": ["src/**/*.ts"],
  "exclude": [
    "node_modules",
    "dist",
    "src/scripts/**",
    // src/test/** holds the integration harness, whose resetDb() TRUNCATEs
    // every table. Nothing in the app imports it, but the same argument that
    // keeps the token minter out of the image applies here with more force:
    // a function that empties the database has no business being inside a
    // production artifact at all.
    "src/test/**",
    "**/*.test.ts",
    "**/*.spec.ts"
  ]
}
