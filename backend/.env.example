# Copy to .env and adjust. .env is git-ignored.
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:3000

# Postgres — port 5433, not the usual 5432.
#
# Many Linux installs (Ubuntu/Debian) start a system postgres on 5432 at boot,
# so docker-compose publishes ours on 5433 to avoid the clash. If you point this
# at 5432 you will silently connect to your machine's own postgres, which has no
# renki database, and every query will fail with "relation does not exist".
#
# Running the API *inside* compose? The host becomes `db` and the port 5432 —
# compose sets that for you, so you never need to change this file.
DATABASE_URL=postgresql://renki:renki@localhost:5433/renki

# Google auth
#
# Leave a value EMPTY and the app throws at startup — env.ts treats "" as
# missing, and neither of the first two has a fallback. That is deliberate:
# booting with no client ID would accept tokens minted for any Google app.

# OAuth 2.0 Web application client from console.cloud.google.com/apis/credentials.
# Public — it ships to every browser. http://localhost:3000 must be an
# authorised JavaScript origin. No redirect URI is needed; this flow verifies an
# ID token rather than redirecting.
CLIENT_ID=

# Not used by the ID-token flow. If something starts needing it, the code has
# drifted to the authorisation-code flow and should be reconsidered.
CLIENT_SECRET=

# openssl rand -base64 32
# Signs Renki's own session JWTs. Never commit a real one; rotating it logs
# every user out.
JWT_SECRET=

JWT_EXPIRES_IN=7d

# Checked against the `hd` claim, not the email suffix — see auth.service.ts.
ALLOWED_EMAIL_DOMAIN=northsouth.edu

# Lets POST /api/verification/self grant `verified` outright.
#
# Defaults to true in development and false everywhere else, so you do not need
# this line locally. Set it to true on a deployed demo ONLY while real identity
# verification is unbuilt: without it there is no path to `verified` at all, and
# stranger ride requests are refused for every account.
#
# It is a privilege escalation by design. Turn it off the day the real flow
# ships.
ALLOW_SELF_VERIFY=
