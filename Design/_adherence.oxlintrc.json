{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/brand/**",
              "components/core/**",
              "components/patterns/**",
              "ui_kits/renki-app/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Geist|Geist Mono|Instrument Serif))/i]",
        "message": "Font not provided by the design system. Available: Geist, Geist Mono, Instrument Serif."
      },
      {
        "selector": "JSXOpeningElement[name.name='AppLoader'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|className|key|ref|className|style|children)$/]",
        "message": "<AppLoader> doesn't accept that prop. Declared props: label, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='Avatar'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|src|size|shape|dim|className|style|key|ref|className|style|children)$/]",
        "message": "<Avatar> doesn't accept that prop. Declared props: name, src, size, shape, dim, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Avatar'] > JSXAttribute[name.name='shape'] > Literal[value!=/^(?:square|round)$/]",
        "message": "<Avatar> shape must be one of 'square' | 'round'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|live|children|className|style|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: variant, live, children, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:default|secondary|destructive|outline|brand)$/]",
        "message": "<Badge> variant must be one of 'default' | 'secondary' | 'destructive' | 'outline' | 'brand'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|square|mark|block|disabled|onClick|children|className|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, square, mark, block, disabled, onClick, children, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:default|outline|secondary|ghost|destructive|link)$/]",
        "message": "<Button> variant must be one of 'default' | 'outline' | 'secondary' | 'ghost' | 'destructive' | 'link'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:xs|sm|default|lg|xl|icon|icon-sm|icon-lg)$/]",
        "message": "<Button> size must be one of 'xs' | 'sm' | 'default' | 'lg' | 'xl' | 'icon' | 'icon-sm' | 'icon-lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:size|accent|children|className|style|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: size, accent, children, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:default|sm)$/]",
        "message": "<Card> size must be one of 'default' | 'sm'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CodePlate'] > JSXAttribute > JSXIdentifier[name!=/^(?:code|size|caption|className|key|ref|className|style|children)$/]",
        "message": "<CodePlate> doesn't accept that prop. Declared props: code, size, caption, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='FriendRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|note|avatarUrl|children|className|style|key|ref|className|style|children)$/]",
        "message": "<FriendRow> doesn't accept that prop. Declared props: name, note, avatarUrl, children, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='GroupCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:origin|destination|departure|status|members|pendingCount|highlighted|footer|className|style|key|ref|className|style|children)$/]",
        "message": "<GroupCard> doesn't accept that prop. Declared props: origin, destination, departure, status, members, pendingCount, highlighted, footer, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='GroupCard'] > JSXAttribute[name.name='status'] > Literal[value!=/^(?:forming|matched|active|completed|cancelled)$/]",
        "message": "<GroupCard> status must be one of 'forming' | 'matched' | 'active' | 'completed' | 'cancelled'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|defaultValue|placeholder|type|size|disabled|invalid|onChange|className|style|key|ref|className|style|children)$/]",
        "message": "<Input> doesn't accept that prop. Declared props: value, defaultValue, placeholder, type, size, disabled, invalid, onChange, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:default|lg)$/]",
        "message": "<Input> size must be one of 'default' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Label'] > JSXAttribute > JSXIdentifier[name!=/^(?:htmlFor|eyebrow|children|className|style|key|ref|className|style|children)$/]",
        "message": "<Label> doesn't accept that prop. Declared props: htmlFor, eyebrow, children, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Mark'] > JSXAttribute > JSXIdentifier[name!=/^(?:size|tone|className|style|key|ref|className|style|children)$/]",
        "message": "<Mark> doesn't accept that prop. Declared props: size, tone, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Mark'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Mark> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Mark'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:brand|ink|muted)$/]",
        "message": "<Mark> tone must be one of 'brand' | 'ink' | 'muted'."
      },
      {
        "selector": "JSXOpeningElement[name.name='NavShell'] > JSXAttribute > JSXIdentifier[name!=/^(?:items|active|onNavigate|variant|header|children|className|style|key|ref|className|style|children)$/]",
        "message": "<NavShell> doesn't accept that prop. Declared props: items, active, onNavigate, variant, header, children, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='NavShell'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:mobile|sidebar)$/]",
        "message": "<NavShell> variant must be one of 'mobile' | 'sidebar'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Progress'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|className|style|key|ref|className|style|children)$/]",
        "message": "<Progress> doesn't accept that prop. Declared props: value, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='RadioGroup'] > JSXAttribute > JSXIdentifier[name!=/^(?:options|value|onChange|className|style|key|ref|className|style|children)$/]",
        "message": "<RadioGroup> doesn't accept that prop. Declared props: options, value, onChange, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='RideOption'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|title|body|enabled|onClick|className|style|key|ref|className|style|children)$/]",
        "message": "<RideOption> doesn't accept that prop. Declared props: icon, title, body, enabled, onClick, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SearchingRings'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|sublabel|className|key|ref|className|style|children)$/]",
        "message": "<SearchingRings> doesn't accept that prop. Declared props: label, sublabel, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='Sheet'] > JSXAttribute > JSXIdentifier[name!=/^(?:open|title|onClose|children|className|style|key|ref|className|style|children)$/]",
        "message": "<Sheet> doesn't accept that prop. Declared props: open, title, onClose, children, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Skeleton'] > JSXAttribute > JSXIdentifier[name!=/^(?:width|height|className|style|key|ref|className|style|children)$/]",
        "message": "<Skeleton> doesn't accept that prop. Declared props: width, height, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusBanner'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|icon|title|body|action|className|style|key|ref|className|style|children)$/]",
        "message": "<StatusBanner> doesn't accept that prop. Declared props: tone, icon, title, body, action, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusBanner'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:neutral|brand|danger)$/]",
        "message": "<StatusBanner> tone must be one of 'neutral' | 'brand' | 'danger'."
      },
      {
        "selector": "JSXOpeningElement[name.name='StepShell'] > JSXAttribute > JSXIdentifier[name!=/^(?:step|total|title|subtitle|onBack|children|footer|className|style|key|ref|className|style|children)$/]",
        "message": "<StepShell> doesn't accept that prop. Declared props: step, total, title, subtitle, onBack, children, footer, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SwipeCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|avatarUrl|badge|facts|intent|note|offset|className|style|key|ref|className|style|children)$/]",
        "message": "<SwipeCard> doesn't accept that prop. Declared props: name, avatarUrl, badge, facts, intent, note, offset, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SwipeCard'] > JSXAttribute[name.name='intent'] > Literal[value!=/^(?:yes|no)$/]",
        "message": "<SwipeCard> intent must be one of 'yes' | 'no'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tabs'] > JSXAttribute > JSXIdentifier[name!=/^(?:tabs|value|onChange|children|className|style|key|ref|className|style|children)$/]",
        "message": "<Tabs> doesn't accept that prop. Declared props: tabs, value, onChange, children, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Toast'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|children|className|style|key|ref|className|style|children)$/]",
        "message": "<Toast> doesn't accept that prop. Declared props: tone, children, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Toast'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:default|success|error)$/]",
        "message": "<Toast> tone must be one of 'default' | 'success' | 'error'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Wordmark'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|size|className|style|key|ref|className|style|children)$/]",
        "message": "<Wordmark> doesn't accept that prop. Declared props: tone, size, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Wordmark'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:default|inverse)$/]",
        "message": "<Wordmark> tone must be one of 'default' | 'inverse'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Wordmark'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Wordmark> size must be one of 'sm' | 'md' | 'lg'."
      }
    ]
  },
