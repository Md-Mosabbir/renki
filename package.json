{
  "name": "renki",
  "version": "0.1.0",
  "private": true,
  "description": "Renki monorepo — Express API + web client",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "npm run dev -w @renki/backend",
    "build": "npm run build -w @renki/backend",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "auth:test": "npx serve tools/auth-test -l 3000",
    "migrate": "npm run migrate -w @renki/backend",
    "seed": "npm run seed -w @renki/backend",
    "verification:test": "npx serve tools/gender-verification -l 3001",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test -w @renki/backend",
    "test:watch": "npm run test:watch -w @renki/backend"
  },
  "devDependencies": {
    "prettier": "^3.9.6"
  }
}
