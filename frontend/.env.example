# Copy to .env.local. Both values are public — no secrets belong in this file,
# because anything prefixed NEXT_PUBLIC_ is compiled into the browser bundle.

NEXT_PUBLIC_API_URL=http://localhost:4000/api

# From Google Cloud Console → Credentials → OAuth 2.0 Client ID (Web).
# http://localhost:3000 must be listed as an authorised JavaScript origin.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
