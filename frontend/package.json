{
  "name": "@renki/frontend",
  "version": "0.1.0",
  "private": true,
  "description": "Renki web client",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "//dev": "Port is pinned: backend CORS_ORIGIN is http://localhost:3000 and Google Sign-In only accepts registered origins.",
    "dev": "next dev --turbopack --port 3000",
    "build": "next build",
    "start": "next start --port 3000",
    "//typecheck": "LayoutProps/PageProps are GENERATED into .next/types by build or dev. tsc alone fails on a clean checkout, so typegen must run first.",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.33.0",
    "next": "16.3.2",
    "next-themes": "^0.4.6",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.19.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "three": "^0.185.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.185.4",
    "eslint": "^9",
    "eslint-config-next": "16.3.2",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
